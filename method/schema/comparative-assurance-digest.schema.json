{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rahp.dev/schema/comparative-assurance-digest.schema.json",
  "title": "RAHP Comparative Assurance Digest",
  "description": "Portable contract for a profile-bound comparison of two RAHP assessments. The digest distinguishes assessment-process change, evidence change, assurance outcome and release acceptability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "baseline",
    "candidate",
    "profile",
    "comparability",
    "scope",
    "finding_deltas",
    "dimensions",
    "overall",
    "recommendations",
    "reassessment_triggers"
  ],
  "properties": {
    "schema_version": {"const": "rahp-comparative-assurance-digest/v1"},
    "comparison_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "baseline": {"$ref": "#/$defs/assessmentRef"},
    "candidate": {"$ref": "#/$defs/assessmentRef"},
    "profile": {"$ref": "#/$defs/profileRef"},
    "comparability": {"$ref": "#/$defs/comparability"},
    "scope": {"$ref": "#/$defs/scope"},
    "scope_delta": {"$ref": "#/$defs/scopeDelta"},
    "finding_deltas": {
      "type": "array",
      "items": {"$ref": "#/$defs/findingDelta"}
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dimensionResult"}
    },
    "overall": {"$ref": "#/$defs/overallResult"},
    "recommendations": {
      "type": "array",
      "items": {"$ref": "#/$defs/recommendation"}
    },
    "reassessment_triggers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "comparability": {
            "properties": {"status": {"const": "not_comparable"}},
            "required": ["status"]
          }
        },
        "required": ["comparability"]
      },
      "then": {
        "properties": {
          "overall": {
            "properties": {
              "judgment": {"const": "not_comparable"},
              "release_disposition": {"enum": ["indeterminate", "not_applicable"]}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "assessmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_id", "artifact_ref", "schema_version", "profile_id", "profile_version"],
      "properties": {
        "assessment_id": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "profile_version": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "artifact_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1}
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons", "matched_basis", "unmatched_basis"],
      "properties": {
        "status": {"enum": ["compatible", "partial", "not_comparable"]},
        "reasons": {"$ref": "#/$defs/nonEmptyStringArray"},
        "matched_basis": {"$ref": "#/$defs/nonEmptyStringArray"},
        "unmatched_basis": {"$ref": "#/$defs/nonEmptyStringArray"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["partial", "not_comparable"]}}},
          "then": {
            "properties": {
              "reasons": {"minItems": 1},
              "unmatched_basis": {"minItems": 1}
            }
          }
        }
      ]
    },
    "componentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "resolved_ref", "reason"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "resolved_ref": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "supportingDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "resolved_ref", "treatment"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "resolved_ref": {"type": "string", "minLength": 1},
        "treatment": {"enum": ["observed_not_assessed", "independently_assessed"]},
        "independent_assessment_ref": {"type": "string", "minLength": 1},
        "limitations": {"$ref": "#/$defs/nonEmptyStringArray"}
      },
      "allOf": [
        {
          "if": {"properties": {"treatment": {"const": "independently_assessed"}}},
          "then": {"required": ["independent_assessment_ref"]}
        },
        {
          "if": {"properties": {"treatment": {"const": "observed_not_assessed"}}},
          "then": {"not": {"required": ["independent_assessment_ref"]}}
        }
      ]
    },
    "excludedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "reason"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directly_assessed", "supporting_dependencies", "excluded", "coverage_state", "limitations"],
      "properties": {
        "directly_assessed": {"type": "array", "items": {"$ref": "#/$defs/componentRef"}},
        "supporting_dependencies": {"type": "array", "items": {"$ref": "#/$defs/supportingDependency"}},
        "excluded": {"type": "array", "items": {"$ref": "#/$defs/excludedComponent"}},
        "coverage_state": {"enum": ["complete", "bounded", "partial", "insufficient"]},
        "limitations": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "scopeChangeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "changed"],
      "properties": {
        "added": {"$ref": "#/$defs/nonEmptyStringArray"},
        "removed": {"$ref": "#/$defs/nonEmptyStringArray"},
        "changed": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "scopeDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "material_change", "directly_assessed", "supporting_dependencies",
        "excluded", "coverage", "newly_admitted_components", "limitations"
      ],
      "properties": {
        "status": {"enum": ["equivalent", "expanded", "contracted", "changed", "indeterminate"]},
        "material_change": {"type": "boolean"},
        "directly_assessed": {"$ref": "#/$defs/scopeChangeSet"},
        "supporting_dependencies": {"$ref": "#/$defs/scopeChangeSet"},
        "excluded": {"$ref": "#/$defs/scopeChangeSet"},
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "candidate", "change"],
          "properties": {
            "baseline": {"enum": ["complete", "bounded", "partial", "insufficient"]},
            "candidate": {"enum": ["complete", "bounded", "partial", "insufficient"]},
            "change": {"enum": ["preserved", "strengthened", "weakened", "not_comparable"]}
          }
        },
        "newly_admitted_components": {"$ref": "#/$defs/nonEmptyStringArray"},
        "limitations": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "findingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "evidence_refs"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "findingDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta_id", "state", "match_basis", "baseline", "candidate", "evidence_change"],
      "properties": {
        "delta_id": {"type": "string", "minLength": 1},
        "state": {
          "enum": [
            "resolved", "introduced", "unchanged", "changed", "reopened",
            "not_reassessed", "evidence_strengthened", "evidence_weakened",
            "no_longer_applicable", "unmatched"
          ]
        },
        "match_basis": {"type": "string", "minLength": 1},
        "baseline": {"anyOf": [{"$ref": "#/$defs/findingRef"}, {"type": "null"}]},
        "candidate": {"anyOf": [{"$ref": "#/$defs/findingRef"}, {"type": "null"}]},
        "disposition_changed": {"type": "boolean"},
        "evidence_change": {"enum": ["strengthened", "preserved", "weakened", "conflicting", "not_comparable", "none"]},
        "limitations": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "comparativeJudgment": {
      "enum": [
        "materially_improved", "improved", "mixed", "no_material_change",
        "regressed", "materially_regressed", "indeterminate", "not_comparable"
      ]
    },
    "judgmentBasis": {
      "type": "object",
      "required": ["judgment", "confidence", "justification", "evidence_refs", "counterevidence_refs", "unresolved_limitations"],
      "properties": {
        "judgment": {"$ref": "#/$defs/comparativeJudgment"},
        "confidence": {"enum": ["high", "moderate", "low", "insufficient"]},
        "justification": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStringArray"},
        "counterevidence_refs": {"$ref": "#/$defs/nonEmptyStringArray"},
        "unresolved_limitations": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "dimensionResult": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/judgmentBasis"},
        {
          "type": "object",
          "required": ["dimension_id", "category", "comparability"],
          "properties": {
            "dimension_id": {"type": "string", "minLength": 1},
            "category": {"enum": ["assessment_process", "evidence", "assurance_outcome", "release_acceptability"]},
            "comparability": {"enum": ["compatible", "partial", "not_comparable"]}
          }
        }
      ]
    },
    "overallResult": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/judgmentBasis"},
        {
          "type": "object",
          "required": ["release_disposition", "release_superiority_established"],
          "properties": {
            "release_disposition": {
              "enum": ["acceptable", "conditionally_acceptable", "not_acceptable", "human_judgment_required", "indeterminate", "not_applicable"]
            },
            "release_superiority_established": {"type": "boolean"}
          }
        }
      ]
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "basis", "normative"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "basis": {"$ref": "#/$defs/nonEmptyStringArray"},
        "normative": {"type": "boolean"}
      }
    }
  }
}
