{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rahp.dev/schema/assessment-lifecycle.schema.json",
  "title": "RAHP finite assessment lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assessment_id", "mode", "state", "history"],
  "properties": {
    "schema": {"const": "rahp-assessment-lifecycle/v1"},
    "assessment_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["steady-state", "clean-room"]},
    "state": {"enum": ["DISCOVERED", "QUALIFIED", "ROUTED", "ASSESSMENT_REQUIRED", "EVIDENCE_REQUIRED", "EVIDENCE_READY", "ASSESSED", "TERMINAL"]},
    "terminal_outcome": {"enum": ["PASS", "FAIL", "INDETERMINATE", "NOT_APPLICABLE", "UNMAPPED"]},
    "blocking_reason": {"type": ["object", "null"]},
    "lineage": {"type": "object"},
    "capabilities": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "resilience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "reason"],
          "properties": {
            "disposition": {"enum": ["executed", "not-applicable", "required-but-not-executed"]},
            "reason": {"type": "string", "minLength": 1},
            "provenance": {"type": "object"}
          },
          "allOf": [
            {
              "if": {"properties": {"disposition": {"const": "not-applicable"}}, "required": ["disposition"]},
              "then": {"required": ["provenance"]}
            }
          ]
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "reason"],
        "properties": {
          "from": {"type": ["string", "null"]},
          "to": {"type": "string"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "TERMINAL"}}},
      "then": {"required": ["terminal_outcome"]}
    },
    {
      "if": {"properties": {"state": {"not": {"const": "TERMINAL"}}}},
      "then": {"not": {"required": ["terminal_outcome"]}}
    }
  ]
}
