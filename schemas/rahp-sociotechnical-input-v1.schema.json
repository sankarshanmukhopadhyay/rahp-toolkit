{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "rahp-sociotechnical-input/v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "deployment",
            "composition",
            "flow",
            "implementation",
            "specification"
          ]
        }
      },
      "required": [
        "id",
        "type"
      ]
    },
    "source_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "repository",
          "revision"
        ]
      },
      "minItems": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "ownership": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "remedy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "policy",
        "ownership",
        "access",
        "population",
        "remedy"
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "non_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "participation": {
                "enum": [
                  "synthetic",
                  "unrepresented",
                  "attributable"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "role",
              "participation",
              "basis"
            ]
          },
          "minItems": 1
        },
        "scenario_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "coverage_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "beneficiary": {
                "type": "string",
                "minLength": 1
              },
              "burden_bearer": {
                "type": "string",
                "minLength": 1
              },
              "burden": {
                "type": "string",
                "minLength": 1
              },
              "justification": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "beneficiary",
              "burden_bearer",
              "burden",
              "justification"
            ]
          },
          "minItems": 1
        },
        "context_observation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "monitored": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "unobserved": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "freshness_limit": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "monitored",
            "unobserved",
            "freshness_limit"
          ]
        }
      },
      "required": [
        "purpose",
        "scope",
        "non_scope",
        "actors",
        "scenario_sources",
        "coverage_limits",
        "alternatives",
        "assumptions",
        "controls",
        "context_observation"
      ]
    },
    "assessors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "independence_review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "enum": [
                  "verified",
                  "unknown"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "state",
              "basis"
            ]
          },
          "dependence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "control": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "maintainers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "corpus": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "model_prompt": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "fixtures": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "control",
              "maintainers",
              "corpus",
              "model_prompt",
              "fixtures"
            ]
          }
        },
        "required": [
          "id",
          "independence_review",
          "dependence"
        ]
      },
      "minItems": 1
