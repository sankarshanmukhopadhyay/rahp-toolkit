    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "independent_human": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "independent_human",
        "basis"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "INDETERMINATE",
        "NOT_APPLICABLE"
      ]
    }
  },
  "required": [
    "schema",
    "subject",
    "source_pins",
    "context",
    "frame",
    "assessors",
    "propositions",
    "evidence",
    "disposition",
    "disagreements",
    "obligations",
    "challenge_route",
    "lineage",
    "review"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rahp/schemas/rahp-sociotechnical-input-v1.schema.json",
  "title": "Opt-in RAHP sociotechnical assessment input v1"
}
