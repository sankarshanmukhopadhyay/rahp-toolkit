    "propositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "applicable": {
            "type": "boolean"
          },
          "not_applicable_reason": {
            "type": "string"
          },
          "required_classes": {
            "type": "array",
            "items": {
              "enum": [
                "static-specification-analysis",
                "repository-fixture",
                "synthetic-test",
                "runtime-observation",
                "governance-evidence",
                "model/evidence-contract-definition"
              ]
            },
            "minItems": 1
          },
          "independent_corroboration_required": {
            "type": "boolean"
          },
          "evaluator": {
            "enum": [
              "adjudicated",
              "disclosure-pressure",
              "meaningful-choice"
            ]
          },
          "facts": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "claim",
          "applicable",
          "not_applicable_reason",
          "required_classes",
          "independent_corroboration_required",
          "evaluator",
          "facts",
          "evidence_ids"
        ]
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "static-specification-analysis",
              "repository-fixture",
              "synthetic-test",
              "runtime-observation",
              "governance-evidence",
              "model/evidence-contract-definition"
            ]
          },
          "status": {
            "enum": [
              "supported",
              "refuted",
              "unknown"
            ]
          },
          "freshness": {
            "enum": [
              "current",
              "stale",
              "unknown"
            ]
          },
          "sufficient": {
            "type": "boolean"
          },
          "context_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_pin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "artifact": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "repository",
              "revision"
            ]
          },
          "assessor": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source",
              "revision",
              "description"
            ]
          }
        },
        "required": [
          "id",
          "proposition",
          "class",
          "status",
          "freshness",
          "sufficient",
          "context_digest",
          "source_pin",
          "assessor",
          "provenance"
        ]
      },
      "minItems": 0
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizational_risk_acceptor": {
          "type": "string",
          "minLength": 1
        },
        "affected_parties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "affected_party_agreement": {
          "enum": [
            "unknown",
            "agreed",
            "objected"
          ]
        },
        "work_item_state": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "organizational_risk_acceptor",
        "affected_parties",
        "affected_party_agreement",
        "work_item_state",
        "rationale"
      ]
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "decision_role": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "unresolved",
              "resolved"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "proposition",
          "evidence_ids",
          "decision_role",
          "state",
          "rationale"
        ]
      },
      "minItems": 0
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "technical-repair",
              "human-remedy"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "acceptance_criterion": {
            "type": "string",
            "minLength": 1
          }
