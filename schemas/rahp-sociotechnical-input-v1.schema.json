    "challenge_route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "unverified",
            "unavailable",
            "demonstrated"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "account_independent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "owner",
        "account_independent",
        "evidence",
        "description"
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_assessment": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_context": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "policy": {
                  "type": "string",
                  "minLength": 1
                },
                "ownership": {
                  "type": "string",
                  "minLength": 1
                },
                "access": {
                  "type": "string",
                  "minLength": 1
                },
                "population": {
                  "type": "string",
                  "minLength": 1
                },
                "remedy": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "policy",
                "ownership",
                "access",
                "population",
                "remedy"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "previous_assessment",
        "previous_context"
      ]
