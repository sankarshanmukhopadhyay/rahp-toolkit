{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/rahp-toolkit/schemas/vti-assessment.schema.json",
  "title": "RAHP VTI composition assessment submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assessment_id",
    "profile",
    "vti_source",
    "family",
    "assessor",
    "assessed_at",
    "scope",
    "disposition",
    "method",
    "requirements",
    "proposition",
    "evidence",
    "counter_cases",
    "residual_uncertainty",
    "reassessment"
  ],
  "properties": {
    "schema": {
      "const": "rahp-vti-assessment/v1"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "const": "rahp-vti-composition-assessment/v1"
    },
    "vti_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "document_status",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "trustoverip/dtgwg-vti-spec"
        },
        "document_status": {
          "type": "string",
          "pattern": "^Working Draft "
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "assessor": {
      "type": "object",
      "required": [
        "programme",
        "repository"
      ],
      "properties": {
        "programme": {
          "const": "RAHP"
        },
        "repository": {
          "const": "sankarshanmukhopadhyay/rahp-toolkit"
        }
      }
    },
    "assessed_at": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "enum": [
        "supported",
        "refuted",
        "indeterminate"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^VTI-CMP-[0-9]{3}$"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "proposition": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "test",
              "fixture",
              "review",
              "issue",
              "commit",
              "runtime",
              "specification"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "counter_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residual_uncertainty": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reassessment": {
      "type": "object",
      "required": [
        "state",
        "triggers"
      ],
      "properties": {
        "state": {
          "enum": [
            "current",
            "stale",
            "superseded"
          ]
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "vti_revision_changed",
              "component_version_changed",
              "policy_or_profile_changed",
              "material_configuration_changed",
              "evidence_superseded",
              "evidence_contradicted"
            ]
          }
        }
      }
    },
    "family": {
      "type": "string",
      "minLength": 1
    }
  }
}
