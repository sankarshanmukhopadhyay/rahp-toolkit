{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rahp.invalid/schemas/rahp-evidence-producer-result-v1.schema.json",
  "title": "RAHP executable evidence producer result v1",
  "type": "object",
  "required": ["schema", "producer", "obligation", "source", "execution", "evidence", "claim_boundary", "freshness"],
  "properties": {
    "schema": {"const": "rahp-evidence-producer-result/v1"},
    "producer": {
      "type": "object",
      "required": ["id", "implementation", "repository", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "obligation": {
      "type": "object",
      "required": ["proposition_key", "evidence_contract_key", "evidence_requirement_ids"],
      "properties": {
        "proposition_key": {"type": "string", "pattern": "^rahp-obligation:[0-9a-f]{20}$"},
        "evidence_contract_key": {"type": "string", "pattern": "^rahp-evidence-contract:[0-9a-f]{20}$"},
        "evidence_requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "assessment_lineage": {"type": "array", "items": {"type": ["string", "object"]}}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["pins"],
      "properties": {
        "pins": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourcePin"}
        },
        "configuration_identity": {"type": ["string", "object"]},
        "runtime_identity": {"type": ["string", "object"]}
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": ["id", "runner", "timestamp", "determinism", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "runner": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "determinism": {"enum": ["deterministic", "non-deterministic", "environment-dependent"]},
        "status": {"enum": ["succeeded", "failed", "unavailable"]},
        "environment": {"type": ["string", "object"]},
        "failure": {"type": ["string", "object", "null"]}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["status", "evidence_class", "artifacts", "observations"],
      "properties": {
        "status": {"enum": ["observed", "not-tested", "evidence-incomplete", "failed"]},
        "evidence_class": {"type": "string", "minLength": 1},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "media_type", "sha256", "provenance"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "media_type": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "uri": {"type": "string"},
              "provenance": {
                "type": "object",
                "required": ["producer_id"],
                "properties": {"producer_id": {"type": "string", "minLength": 1}},
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "observations": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "claim_boundary": {
      "type": "object",
      "required": ["supports", "does_not_support", "limitations", "residual_uncertainty"],
      "properties": {
        "supports": {"type": "array", "items": {"type": "string"}},
        "does_not_support": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "residual_uncertainty": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "freshness": {
      "type": "object",
      "required": ["valid_against", "invalidation_keys"],
      "properties": {
        "valid_against": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourcePin"}},
        "invalidation_keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "sourcePin": {
      "type": "object",
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "role": {"enum": ["normative", "implementation", "deployment", "runtime", "configuration", "producer", "other"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
