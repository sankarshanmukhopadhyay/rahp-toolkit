{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rahp.invalid/schemas/rahp-specialist-return-v1.schema.json",
  "title": "RAHP specialist return v1",
  "type": "object",
  "required": ["schema", "source_assessment_id", "specialist", "specialist_assessment_id", "disposition", "delivery"],
  "properties": {
    "schema": {"const": "rahp-specialist-return/v1"},
    "source_assessment_id": {"type": "string", "minLength": 1},
    "correlation_key": {"type": "string", "minLength": 1},
    "specialist": {"type": "string", "minLength": 1},
    "specialist_assessment_id": {"type": "string", "minLength": 1},
    "disposition": {"$ref": "rahp-assessor-result-v1.schema.json"},
    "remediation": {"$ref": "rahp-evidence-remediation-v1.schema.json"},
    "delivery": {
      "type": "object",
      "required": ["payload_digest", "outbox_state"],
      "properties": {
        "payload_digest": {"type": "string", "minLength": 1},
        "outbox_state": {"enum": ["pending", "delivered", "acknowledged", "retryable-error"]},
        "attempt_count": {"type": "integer", "minimum": 0},
        "destination": {"type": "string"},
        "last_error": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
