  "propositions": [
    {"id": "WIT-ROLE-001", "issue": 1081, "statement": "Party non-participation is distinct from organizational or governance independence."},
    {"id": "WIT-ROLE-002", "issue": 1081, "statement": "Witness role or independence is not established solely by the witness's self-assertion."},
    {"id": "WIT-ID-001", "issue": 1081, "statement": "Where the pinned task contract requires ceremony identity continuity, VWC issuer, session recipient and response signer identify the same witness."},
    {"id": "WIT-ID-002", "issue": 1081, "statement": "Ceremony identity continuity does not prove organizational independence or require reuse of unrelated operational identifiers."},
    {"id": "WIT-TIME-001", "issue": 1082, "statement": "VRC and VWC lifecycle state do not cascade implicitly."},
    {"id": "WIT-REV-001", "issue": 1082, "statement": "Revocation reason semantics are not stronger than the profile evidence exposes."},
    {"id": "WIT-KEY-001", "issue": 1082, "statement": "Historical key authorization does not prove absence of compromise at issuance."},
    {"id": "WIT-AVAIL-001", "issue": 1082, "statement": "Unavailable status evidence is neither VALID nor REVOKED."},
    {"id": "WIT-SUCC-001", "issue": 1082, "statement": "Availability succession does not imply status-mutation authority succession."},
    {"id": "WIT-RET-001", "issue": 1082, "statement": "Minimal retention creates an explicit later-review evidence boundary."}
  ],
