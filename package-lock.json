{
  "name": "rahp-toolkit",
  "version": "1.6.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "rahp-toolkit",
      "version": "1.6.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@rahp/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@rahp/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@rahp/graph": {
      "resolved": "packages/graph",
      "link": true
    },
    "node_modules/@rahp/schema": {
      "resolved": "packages/schema",
      "link": true
    },
    "packages/cli": {
      "name": "@rahp/cli",
      "version": "1.6.0",
      "dependencies": {
        "@rahp/core": "1.6.0",
        "@rahp/graph": "1.6.0"
      },
      "bin": {
        "rahp-ts": "dist/cli.js"
      }
    },
    "packages/core": {
      "name": "@rahp/core",
      "version": "1.6.0",
      "dependencies": {
        "@rahp/schema": "1.6.0"
      }
    },
    "packages/graph": {
      "name": "@rahp/graph",
      "version": "1.6.0"
    },
    "packages/schema": {
      "name": "@rahp/schema",
      "version": "1.6.0"
    }
  }
}
